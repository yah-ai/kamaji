# Busybox configuration deltas for the kamaji microVM guest rootfs.
#
# Applied over busybox's own `make defconfig` by build-guest-image.sh (a plain
# key=value overlay; busybox's kconfig has no merge_config.sh).
#
# The guest init is Rust and does the mounting itself — busybox is here for the
# *job*, whose argv is routinely `/bin/sh -c "…"`. So this file is short by
# design: make it static, and take out the applets that either cannot link
# statically or would shadow something the image already owns.

# Static, because the rootfs has no dynamic loader and no libc.so in it.
CONFIG_STATIC=y

# Not `busybox --install`-ing at runtime: the rootfs is read-only, so every
# applet symlink has to exist in the image. The build script creates them.
CONFIG_INSTALL_APPLET_SYMLINKS=y

# `tc` does not compile against current kernel headers (its struct definitions
# went out of step upstream), and nothing in a guest shapes traffic — the host
# side of the TAP is where kamaji does its networking.
# CONFIG_TC is not set

# No init, and no shutdown applets that would race ours. /sbin/init is
# kamaji-guest-init, which owns the reset path: it resets the VM (not powers it
# off) because that is what makes the VMM process exit, which is the only
# completion signal kamaji's supervisor has.
# CONFIG_INIT is not set
# CONFIG_LINUXRC is not set

# No PID-1 adjacent daemons: a guest runs one job and resets.
# CONFIG_INETD is not set
# CONFIG_SYSLOGD is not set
# CONFIG_KLOGD is not set
# CONFIG_UDHCPD is not set
# CONFIG_UDHCPC is not set
# CONFIG_FEATURE_SYSTEMD is not set
